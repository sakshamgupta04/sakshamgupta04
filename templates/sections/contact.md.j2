<h3 style="margin-top: 0; margin-bottom: 8px;">🚀 Let's Connect <a id="contact"></a></h3>

<p style="margin-top: 0; margin-bottom: 12px; font-size: 13px; color: #A5B4CF;">
I'm open to software engineering opportunities, AI/ML projects, and technical collaborations. Feel free to get in touch!
</p>

{% set contact_links = [] %}
{% if has(profile.links.portfolio) %}{% set _ = contact_links.append("<a href=\"" ~ profile.links.portfolio ~ "\" style=\"padding: 5px 10px; background-color: #17243C; border: 1px solid #2DD4BF; border-radius: 6px; color: #2DD4BF; font-weight: 600; font-size: 11.5px;\">🌐 <b>Portfolio ↗</b></a>") %}{% endif %}
{% if has(profile.links.email) %}{% set mailto_url = profile.links.email if profile.links.email.startswith('mailto:') else 'mailto:' ~ profile.links.email %}{% set _ = contact_links.append("<a href=\"" ~ mailto_url ~ "\" style=\"padding: 5px 10px; background-color: #17243C; border: 1px solid #8B5CF6; border-radius: 6px; color: #C084FC; font-weight: 600; font-size: 11.5px;\">✉️ <b>Email ↗</b></a>") %}{% endif %}
{% if has(profile.links.linkedin) %}{% set _ = contact_links.append("<a href=\"" ~ profile.links.linkedin ~ "\" style=\"padding: 5px 10px; background-color: #17243C; border: 1px solid #38BDF8; border-radius: 6px; color: #38BDF8; font-weight: 600; font-size: 11.5px;\">💼 <b>LinkedIn ↗</b></a>") %}{% endif %}
{% if has(profile.links.github) %}{% set _ = contact_links.append("<a href=\"" ~ profile.links.github ~ "\" style=\"padding: 5px 10px; background-color: #17243C; border: 1px solid #A5B4CF; border-radius: 6px; color: #F4F7FF; font-weight: 600; font-size: 11.5px;\">🐙 <b>GitHub ↗</b></a>") %}{% endif %}
{% if has(profile.links.leetcode) %}{% set _ = contact_links.append("<a href=\"" ~ profile.links.leetcode ~ "\" style=\"padding: 5px 10px; background-color: #17243C; border: 1px solid #F59E0B; border-radius: 6px; color: #FBBF24; font-weight: 600; font-size: 11.5px;\">🧩 <b>LeetCode ↗</b></a>") %}{% endif %}
{% if has(profile.links.resume_pdf) %}{% set _ = contact_links.append("<a href=\"" ~ profile.links.resume_pdf ~ "\" style=\"padding: 5px 10px; background-color: #17243C; border: 1px solid #38BDF8; border-radius: 6px; color: #38BDF8; font-weight: 600; font-size: 11.5px;\">📄 <b>Resume ↓</b></a>") %}{% endif %}
<p style="margin: 8px 0 0 0; line-height: 2.2;">
{{ contact_links | join(" &nbsp; ") }}
</p>
