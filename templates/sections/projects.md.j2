## 🚀 $ featured.builds — Featured Projects <a id="projects"></a>

{% if has(profile.projects) %}
{% set sorted_projects = [] %}
{% for p in profile.projects if p.featured %}{% set _ = sorted_projects.append(p) %}{% endfor %}
{% for p in profile.projects if not p.featured %}{% set _ = sorted_projects.append(p) %}{% endfor %}
<table>
  <tr>
{% for p in sorted_projects[:3] %}
    <td width="33%" valign="top">
      <a id="{{ p.slug }}"></a>
      {% if has(p.image) %}
      <img src="{{ p.image }}" alt="{{ p.title }}" width="100%">
      <br><br>
      {% endif %}
      <b>{{ p.title }}</b><br>
      {% if has(p.subtitle) %}<sub>{{ p.subtitle }}</sub><br>{% endif %}
      <p><i>{{ p.tagline }}</i></p>
      {% if has(p.highlights) %}
      <b>Key Highlights:</b>
      <ul>
      {% for h in p.highlights %}
        <li>{{ h }}</li>
      {% endfor %}
      </ul>
      {% endif %}
      {% if has(p.results) %}
      <b>Measured Evaluation &amp; Benchmarks:</b>
      <ul>
      {% for r in p.results %}
        <li>{{ r }}</li>
      {% endfor %}
      </ul>
      {% endif %}
      {% if has(p.stack) %}
      <b>Stack:</b>
      {% for s in p.stack %}<code>{{ s }}</code>{% if not loop.last %} {% endif %}{% endfor %}
      <br><br>
      {% endif %}
      {% set proj_links = [] %}
      {% if has(p.links.live) %}{% set _ = proj_links.append("<a href=\"" ~ p.links.live ~ "\">▶️ <b>Live Site</b></a>") %}{% endif %}
      {% if has(p.links.demo) %}{% set _ = proj_links.append("<a href=\"" ~ p.links.demo ~ "\">🔍 <b>Case Study</b></a>") %}{% endif %}
      {% if has(p.repo) %}{% set _ = proj_links.append("<a href=\"https://github.com/" ~ p.repo ~ "\">📦 <b>Code</b></a>") %}{% endif %}
      {% if has(proj_links) %}
      {{ proj_links | join(" &nbsp;|&nbsp; ") }}
      {% endif %}
    </td>
{% endfor %}
  </tr>
</table>

{% if sorted_projects | length > 3 %}
{% for p in sorted_projects %}
{% if loop.index > 3 %}
### {{ p.title }} <a id="{{ p.slug }}"></a>
> {{ p.tagline }}
{% if has(p.stack) %}- **Technologies:** {% for s in p.stack %}<code>{{ s }}</code>{% if not loop.last %} &nbsp;•&nbsp; {% endif %}{% endfor %}{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{% endif %}
