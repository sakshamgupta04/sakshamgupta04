{% if has(profile.projects) %}
## ⚡ Featured Projects <a id="projects"></a>

{% set sorted_projects = [] %}
{% for p in profile.projects if p.featured %}{% set _ = sorted_projects.append(p) %}{% endfor %}
{% for p in profile.projects if not p.featured %}{% set _ = sorted_projects.append(p) %}{% endfor %}
<!-- GitHub-compatible, full-width project rows. All case-study information is visible. -->
{% for p in sorted_projects[:3] %}
<a id="{{ p.slug }}"></a>
<table width="100%">
<tr>
{% if has(p.image) %}<td width="32%" valign="top" align="center"><a href="{{ p.links.demo if has(p.links.demo) else (p.links.live if has(p.links.live) else 'https://github.com/' ~ p.repo if has(p.repo) else '#' ~ p.slug) }}"><img src="{{ p.image }}" alt="{{ p.title }} project screenshot" width="100%"></a></td>{% endif %}
<td width="68%" valign="top">
{% if has(p.category) %}<sub><strong>{{ p.category }}</strong></sub>{% endif %}
<h3>0{{ loop.index }} · {{ p.title }}</h3>
{% if has(p.subtitle) %}<p><em>{{ p.subtitle }}</em></p>{% endif %}
{% if has(p.tagline) %}<p>{{ p.tagline }}</p>{% endif %}
{% if has(p.challenge) %}<p><b>Engineering challenge:</b> {{ p.challenge }}</p>{% endif %}
{% if has(p.approach) %}<p><b>Technical approach:</b> {{ p.approach }}</p>{% endif %}
{% if has(p.highlights) %}<p><b>Implementation highlights:</b></p>
<ul>{% for h in p.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
{% if has(p.results) %}<p><b>Measured Evaluation &amp; Benchmarks:</b></p>
<ul>{% for r in p.results %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
{% if has(p.stack) %}<p><b>Stack:</b> {% for s in p.stack %}<code>{{ s }}</code>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
<p>
{% if has(p.links.demo) %}<a href="{{ p.links.demo }}"><b>🔍 Case Study ↗</b></a>{% endif %}
{% if has(p.links.live) %}{% if has(p.links.demo) %} &nbsp;·&nbsp; {% endif %}<a href="{{ p.links.live }}"><b>▶️ Live Site ↗</b></a>{% endif %}
{% if has(p.repo) %}{% if has(p.links.demo) or has(p.links.live) %} &nbsp;·&nbsp; {% endif %}<a href="https://github.com/{{ p.repo }}"><b>📦 Source Code ↗</b></a>{% endif %}
</p>
</td>
</tr>
</table>
{% endfor %}
{% if sorted_projects | length > 3 %}
{% for p in sorted_projects[3:] %}
**{{ p.title }}** — {{ p.tagline }}{% if has(p.repo) %} · [Code](https://github.com/{{ p.repo }}){% endif %}
{% endfor %}
{% endif %}
{% endif %}
