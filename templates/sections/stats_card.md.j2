{% if profile.features.stats_card and has(github_stats) and (has(github_stats.public_repos) or has(github_stats.total_stars)) %}
## 📊 GitHub Statistics <a id="github-stats"></a>

<!-- Transparent cards inherit the viewer's GitHub theme; no solid panels. -->
<table align="center">
  <tr>
    <td width="55%" align="center" valign="middle">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="https://github-readme-stats.vercel.app/api?username={{ profile.identity.handle }}&amp;show_icons=true&amp;include_all_commits=false&amp;count_private=false&amp;theme=transparent&amp;bg_color=00000000&amp;hide_border=true&amp;title_color=79A8FF&amp;text_color=57D9D0&amp;icon_color=C792EA&amp;rank_icon=default&amp;cache_seconds=86400" />
        <img src="https://github-readme-stats.vercel.app/api?username={{ profile.identity.handle }}&amp;show_icons=true&amp;include_all_commits=false&amp;count_private=false&amp;theme=transparent&amp;bg_color=00000000&amp;hide_border=true&amp;title_color=275DAD&amp;text_color=087E8B&amp;icon_color=9B4DCA&amp;rank_icon=default&amp;cache_seconds=86400" alt="GitHub statistics for {{ profile.identity.handle }}" width="495" />
      </picture>
    </td>
    <td width="45%" align="center" valign="middle">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="https://github-readme-stats.vercel.app/api/top-langs/?username={{ profile.identity.handle }}&amp;layout=compact&amp;langs_count=8&amp;hide_border=true&amp;bg_color=00000000&amp;title_color=79A8FF&amp;text_color=57D9D0&amp;cache_seconds=3600&amp;refresh={{ stats_refresh_key }}" />
        <img src="https://github-readme-stats.vercel.app/api/top-langs/?username={{ profile.identity.handle }}&amp;layout=compact&amp;langs_count=8&amp;hide_border=true&amp;bg_color=00000000&amp;title_color=275DAD&amp;text_color=087E8B&amp;cache_seconds=3600&amp;refresh={{ stats_refresh_key }}" alt="Most used programming languages across public repositories for {{ profile.identity.handle }}" width="380" />
      </picture>
    </td>
  </tr>
</table>

<p align="center">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="https://streak-stats.demolab.com/?user={{ profile.identity.handle }}&amp;theme=transparent&amp;background=00000000&amp;hide_border=true&amp;ring=79A8FF&amp;fire=F59E72&amp;currStreakNum=C792EA&amp;sideNums=79A8FF&amp;currStreakLabel=57D9D0&amp;sideLabels=57D9D0&amp;dates=9CA3AF&amp;timezone=Asia/Kolkata&amp;cache_seconds=3600&amp;refresh={{ stats_refresh_key }}" />
    <img src="https://streak-stats.demolab.com/?user={{ profile.identity.handle }}&amp;theme=transparent&amp;background=00000000&amp;hide_border=true&amp;ring=275DAD&amp;fire=E87942&amp;currStreakNum=9B4DCA&amp;sideNums=275DAD&amp;currStreakLabel=087E8B&amp;sideLabels=087E8B&amp;dates=6B7280&amp;timezone=Asia/Kolkata&amp;cache_seconds=3600&amp;refresh={{ stats_refresh_key }}" alt="GitHub contribution streak statistics for {{ profile.identity.handle }}" width="620" />
  </picture>
</p>
{% endif %}
