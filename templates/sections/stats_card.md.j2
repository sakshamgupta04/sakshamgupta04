{% if profile.features.stats_card and has(github_stats) and (has(github_stats.public_repos) or has(github_stats.total_stars)) %}
## 📊 GitHub Metrics <a id="github-stats"></a>

<p align="center">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="https://streak-stats.demolab.com/?user={{ profile.identity.handle }}&amp;theme=github-dark-blue&amp;hide_border=true&amp;timezone=Asia/Kolkata" />
    <img src="https://streak-stats.demolab.com/?user={{ profile.identity.handle }}&amp;theme=default&amp;hide_border=true&amp;timezone=Asia/Kolkata" alt="GitHub contribution streak statistics for {{ profile.identity.handle }}" width="495" />
  </picture>
</p>


### GitHub Overview

<p align="center">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="https://github-readme-stats.vercel.app/api?username={{ profile.identity.handle }}&amp;show_icons=true&amp;include_all_commits=true&amp;count_private=false&amp;theme=github_dark&amp;hide_border=true&amp;rank_icon=github" />
    <img src="https://github-readme-stats.vercel.app/api?username={{ profile.identity.handle }}&amp;show_icons=true&amp;include_all_commits=true&amp;count_private=false&amp;theme=default&amp;hide_border=true&amp;rank_icon=github" alt="GitHub overview statistics for {{ profile.identity.handle }}" width="495" />
  </picture>
</p>

### Contribution Activity

<p align="center">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="https://github-readme-activity-graph.vercel.app/graph?username={{ profile.identity.handle }}&amp;theme=github-dark&amp;hide_border=true&amp;area=true" />
    <img src="https://github-readme-activity-graph.vercel.app/graph?username={{ profile.identity.handle }}&amp;theme=github-light&amp;hide_border=true&amp;area=true" alt="GitHub contribution activity graph for {{ profile.identity.handle }}" width="100%" />
  </picture>
</p>
{% endif %}

