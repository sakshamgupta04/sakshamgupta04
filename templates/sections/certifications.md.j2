{% if profile.features.education and has(profile.certifications) %}
## 🎖️ Certifications &amp; Achievements <a id="certifications"></a>

{% set categories = namespace(ml=[], other=[]) %}
{% for cert in profile.certifications %}
{% set entry %}<strong>{{ cert.title }}</strong><br><sub>{{ cert.issuer }} · {{ cert.kind | format_cert_kind }}{% if has(cert.url) %} · <a href="{{ cert.url }}">View credential ↗</a>{% endif %}</sub>{% endset %}
{% if cert.issuer in ['Coursera', 'NPTEL'] %}{% set _ = categories.ml.append(entry | trim) %}{% else %}{% set _ = categories.other.append(entry | trim) %}{% endif %}
{% endfor %}
<table>
  <thead>
    <tr>
      <th width="50%" align="left">🧠 AI &amp; Machine Learning</th>
      <th width="50%" align="left">☁️ Cloud &amp; Development</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td valign="top">
        {% for entry in categories.ml %}
        <p>{{ entry }}</p>
        {% endfor %}
      </td>
      <td valign="top">
        {% for entry in categories.other %}
        <p>{{ entry }}</p>
        {% endfor %}
      </td>
    </tr>
  </tbody>
</table>

> 🏆 **Practical AI/ML Training** · Model Institute of Engineering and Technology · March 2025
>
> AI/ML Hands-on Training Program

{% endif %}
